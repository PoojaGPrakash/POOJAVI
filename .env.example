# ─── Supabase (Project Settings → API) ─────────────────────────────
# Public URL and anon (publishable) key. Safe for the browser — all access is
# governed by Row Level Security policies in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: This application never needs the service-role key. Do NOT add it here
# or to any NEXT_PUBLIC_* variable.

# ─── Site ──────────────────────────────────────────────────────────
# Canonical public URL, used for sitemap, Open Graph and canonical links.
NEXT_PUBLIC_SITE_URL=https://www.poojavithelabel.com

# Storage bucket for uploaded images (created by the migrations).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# Fallback contact details — used only until they are set in
# Admin → Settings (database values always take precedence).
NEXT_PUBLIC_FALLBACK_WHATSAPP_NUMBER=+917204687075
NEXT_PUBLIC_FALLBACK_CONTACT_EMAIL=
